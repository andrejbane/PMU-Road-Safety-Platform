# Copy these names into your environment or secret manager.
# Spring Boot does not load this file automatically.
MONGODB_URI=mongodb://localhost:27017/pmu
JWT_SECRET=<base64-encoded-32-byte-random-value>

# Optional: omit both variables for an account to skip creating it.
BOOTSTRAP_MODERATOR_EMAIL=moderator@example.invalid
BOOTSTRAP_MODERATOR_PASSWORD=<choose-a-strong-password>
BOOTSTRAP_REPORT_MODERATOR_EMAIL=report-moderator@example.invalid
BOOTSTRAP_REPORT_MODERATOR_PASSWORD=<choose-a-different-strong-password>
